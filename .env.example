# IMPORTANT: keep comments on their OWN lines, never inline after a value.
# pydantic-settings reads "KEY=value   # note" with the comment AS part of the
# value, which silently breaks things (e.g. a non-empty ADMIN_PASSWORD).

# --- core ---
DATA_DIR=/data

# HOST_DATA_DIR: host path that the Docker daemon sees for the /data volume.
# Required when bookhub runs in a container and launches the converter via
# docker-socket-proxy (docker-out-of-docker). -v bind-mounts are resolved by
# the daemon on the HOST, so container-internal paths won't work.
# Set to the host path mapped to DATA_DIR, e.g. /opt/bookhub/data
# Leave empty (or unset) for local dev (no docker-out-of-docker).
HOST_DATA_DIR=

# set true behind Cloudflare Tunnel / HTTPS (TLS at edge). Over plain http use false.
COOKIE_SECURE=false

# optional seed admin (>=12 chars). Empty -> first visit opens /setup to create the admin.
ADMIN_PASSWORD=

# Option A: token for the cloudflared sidecar tunnel (see BUILD.md §3.5)
CLOUDFLARED_TOKEN=

# --- limits ---
# DOWNLOAD_MAX_MB: books larger than this cannot be VT-verified -> blocked
DOWNLOAD_MAX_MB=32
# CONVERT_MAX_MB: converter upload cap (user's own file, gVisor-sandboxed)
CONVERT_MAX_MB=200
# IMAGE_MAX_MB: image->BMP batch cap (total bytes per request)
IMAGE_MAX_MB=50
# FILE_TTL_MINUTES: prepared download kept this long, then auto-deleted
FILE_TTL_MINUTES=30
DOWNLOAD_CONCURRENCY=3
SCAN_CONCURRENCY=3
CONVERT_CONCURRENCY=1

# --- VirusTotal ---
VT_API_KEY=
# VT_CLEAN_MAX_AGE_DAYS: re-scan "clean" hashes older than this (freshness floor)
VT_CLEAN_MAX_AGE_DAYS=180
# VT_MIN_ENGINES: require >= this many engines reported before trusting clean
VT_MIN_ENGINES=40
# VT_DAILY_CAP: stop calling VT before the 500/day free-tier limit
VT_DAILY_CAP=480

# --- providers ---
# VK_TOKEN: DEPRECATED. VK removed docs.search; provider is always disabled. Leave empty.
VK_TOKEN=
# AA_API_KEY: Anna's Archive donor key (optional); empty -> AA uses HTML search
AA_API_KEY=
LIBGEN_MIRRORS=libgen.la,libgen.li,libgen.vg,libgen.gl
PROVIDER_SEARCH_TIMEOUT_S=15
PROVIDER_RESOLVE_TIMEOUT_S=30

# --- converter sandbox ---
# RUNSC_RUNTIME: set to "runsc" for gVisor (production default, see BUILD.md §8).
# LOCAL DEV (macOS): set to "" to run converter with plain "docker run" (no gVisor).
# gVisor requires a Linux VM with the runsc runtime registered in /etc/docker/daemon.json.
RUNSC_RUNTIME=runsc
CONVERTER_IMAGE=bookhub-converter:latest
CONVERT_TIMEOUT_S=600
OCR_TIMEOUT_S=1200
OCR_LANGS=eng+por+fra+spa
